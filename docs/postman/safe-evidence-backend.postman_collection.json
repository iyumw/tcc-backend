            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"Errada@123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Rota protegida sem token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/perfil",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "perfil"
              ]
            },
            "description": "Esperado: 401 SEM_TOKEN.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}