PORT=8080

# --- Banco de dados (Cloud SQL - PostgreSQL) ---
# Desenvolvimento local: valores que batem com o docker-compose.yml
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=safe_evidence
DB_USER=postgres
DB_PASSWORD=postgres

# Produção no Cloud Run: conexão via socket Unix do Cloud SQL
# DB_SOCKET_PATH=/cloudsql/PROJETO:REGIAO:INSTANCIA

# --- Armazenamento dos vídeos (ver docs/gcs-setup.md) ---
# Vazio = modo local (tmp/videos/). Preenchido = Google Cloud Storage.
GCS_BUCKET=
# Só pra rodar localmente com GCS (no Cloud Run não precisa):
# GOOGLE_APPLICATION_CREDENTIALS=./chave-gcs.json

# Validade das URLs de acesso aos vídeos, em minutos (RN04 = 15)
URL_VALIDADE_MINUTOS=15

# Segredo das URLs assinadas no modo local. Gere um valor aleatório, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
URL_SIGNING_SECRET=

# Endereço público do backend, usado nas URLs do modo local.
# Se vazio, usa o host da própria requisição.
# PUBLIC_BASE_URL=http://192.168.68.110:8080

# --- Serviço de IA (ver docs/contrato-ia.md) ---
# Endereço do serviço de IA. Vazio = análises ficam "Pendente".
# Pra testar sem o modelo real: rode "npm run ia-mock" e use http://localhost:8090
IA_SERVICE_URL=
# Token que o BACKEND manda pro serviço de IA (Authorization: Bearer ...)
IA_TOKEN=
# Token que o SERVIÇO DE IA manda de volta no callback. Obrigatório pra
# aceitar resultados. Gere um valor aleatório como o URL_SIGNING_SECRET.
IA_CALLBACK_TOKEN=
# Tentativas automáticas antes de desistir (RE08) e prazo pra IA responder
IA_MAX_TENTATIVAS=5
IA_TIMEOUT_MINUTOS=30

# --- Portal (login, sessões, CORS) ---
# Endereço(s) do front, separados por vírgula
FRONT_URL=http://localhost:4200
# Segredo que assina os tokens de login. Gere um valor aleatório (mesmo comando do URL_SIGNING_SECRET)
JWT_SECRET=
# RE11: sessão cai após X min sem uso; e dura no máximo Y horas
SESSAO_INATIVIDADE_MINUTOS=15
SESSAO_MAX_HORAS=8

# --- E-mail (códigos MFA) ---
# Sem SMTP_HOST, o código só aparece no terminal do backend.
# Gmail: ative a verificação em 2 etapas e crie uma "senha de app".
# Precisa também: npm install nodemailer
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
