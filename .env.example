PORT=8080
# Em produção (NODE_ENV=production) o backend não sobe sem JWT_SECRET,
# URL_SIGNING_SECRET (só no modo local, sem S3) e DB_SSL_CA (com DB_SSL=true).
# NODE_ENV=production

# --- Banco de dados (AWS RDS - PostgreSQL, ver docs/aws-setup.md) ---
# Para usar o Postgres local do docker-compose: DB_HOST=127.0.0.1,
# DB_PASSWORD=postgres e DB_SSL=false.
DB_HOST=
DB_PORT=5432
DB_NAME=safe_evidence
DB_USER=postgres
DB_PASSWORD=
# O RDS exige SSL. DB_SSL_CA = certificado da AWS (confere que o servidor é
# o RDS de verdade), baixado com:
#   curl -o global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_SSL=true
DB_SSL_CA=./global-bundle.pem

# --- Armazenamento dos vídeos (AWS S3, ver docs/aws-setup.md) ---
# Vazio = modo local (tmp/videos/). Preenchido = bucket do S3.
S3_BUCKET=
AWS_REGION=sa-east-1
# Chaves do usuário do IAM do backend (nunca suba para o Git)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Validade das URLs de acesso aos vídeos, em minutos (RN04 = 15)
URL_VALIDADE_MINUTOS=15

# Segredos: gere um valor aleatório para cada um com
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# URL_SIGNING_SECRET: assina os links dos vídeos no modo local. Vazio = os
#   links deixam de valer quando o backend reinicia.
URL_SIGNING_SECRET=

# Endereço do backend visto de fora (links dos vídeos e callback da IA).
# Vazio = http://localhost:PORT. Preencha quando a IA rodar em outra máquina.
# PUBLIC_BASE_URL=http://192.168.68.110:8080

# --- Serviço de IA (ver docs/contrato-ia.md) ---
# Vazio = as análises ficam "Pendente".
# Para testar sem o modelo real: rode "npm run ia-mock" e use http://localhost:8090
IA_SERVICE_URL=
# Token que o backend manda para o serviço de IA (opcional)
IA_TOKEN=
# Token que o serviço de IA manda de volta no callback (obrigatório)
IA_CALLBACK_TOKEN=
# Tentativas automáticas antes de desistir (RE08) e prazo para a IA responder
IA_MAX_TENTATIVAS=5
IA_TIMEOUT_MINUTOS=30

# --- Carimbo de tempo RFC 3161 (docs/carimbo-tempo.md) ---
# Padrão: FreeTSA. Vazio desliga o carimbo.
TSA_URL=https://freetsa.org/tsr

# --- Portal (login, sessões, CORS) ---
# Endereço(s) do front, separados por vírgula
FRONT_URL=http://localhost:4200
# Assina os tokens de login. Vazio = todas as sessões caem ao reiniciar.
JWT_SECRET=
# RE11: sessão cai após X min sem uso e dura no máximo Y horas
SESSAO_INATIVIDADE_MINUTOS=15
SESSAO_MAX_HORAS=8

# --- E-mail (códigos MFA) ---
# Sem SMTP_HOST, o código só aparece no terminal do backend.
# Gmail: ative a verificação em 2 etapas e crie uma "senha de app".
# Precisa também: npm install nodemailer
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
